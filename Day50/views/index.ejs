<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="mx-auto flex max-w-3xl p-3 justify-between border-b">
        <h1 class="text-2xl font-black">User Management</h1>
        <button class="bg-black text-white p-1 px-2 rounded-lg"><a href="/addUser">Add User</a></button>
    </div>
    <div class="flex justify-center mt-10">

        <% if(users.length==0) {%>
            <div >
                No users available currently
            </div>
        <%} else {%>
            <div class="flex flex-col gap-5">
                <% for(let i=0;i < users.length;i++) {%>
                    <div class="flex gap-2 items-center">

                        <img src="<%= users[i].img %>" alt="profile" class="inline w-10 h-10 rounded-full object-cover">
                        <h1 class="text-neutral-500"><%= users[i].email %> </h1>
                        <h1 ><%= users[i].name %> </h1>
                        
                        <form action="/delete?userid=<%=i%>" method="post">
                            <button class="ml-5 bg-black text-white p-1 text-sm rounded-lg">Delete</button>
                        </form>

                    </div>
                <%}%>
            </div>
        <%}%>    
    </div>
</body>
</html>