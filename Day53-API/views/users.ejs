<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <div style="text-align: center;">
        <h1>Users</h1>
        <div >
            <% for(let i=0;i < users.length; i++){ %>
                <div >
                   <p>Name : <%= users[i].name%></p> 
                   <p>Email:  <%= users[i].email%></p>
                   <p>Age:  <%= users[i].age%></p> 
                </div>
                <br><br>
            <% }%>
        </div>
    </div>
</body>
</html>